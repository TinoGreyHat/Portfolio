# Portfolio TinoGreyHat - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For development (H2 in-memory) - uncomment and use for local dev:
# DB_URL=jdbc:h2:mem:portfolio;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# DB_USERNAME=sa
# DB_PASSWORD=
# DB_DRIVER=org.h2.Driver
# DB_DIALECT=org.hibernate.dialect.H2Dialect

# For production (PostgreSQL) - uncomment and configure:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USERNAME=your_db_user
DB_PASSWORD=your_strong_password_here

# =============================================================================
# JWT CONFIGURATION (CRITICAL - Must be changed for production!)
# =============================================================================
# Generate a strong secret: openssl rand -base64 64
# Must be at least 64 characters for HS512 algorithm
JWT_SECRET=your_very_long_secure_random_base64_secret_key_here_min_64_chars
JWT_EXPIRATION=86400000

# =============================================================================
# ADMIN CONFIGURATION (CRITICAL - Must be changed for production!)
# =============================================================================
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_admin_password_here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins (no trailing slashes)
# For production, include your actual domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# =============================================================================
# MAIL CONFIGURATION (Optional for dev, Required for production contact form)
# =============================================================================
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_TO=recipient_email@example.com

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8080

# =============================================================================
# FRONTEND BUILD CONFIGURATION
# =============================================================================
# Vite base path for GitHub Pages deployment (use '/' for custom domain)
VITE_BASE=./